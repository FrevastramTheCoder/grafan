DATABASE_URL=sqlite:///./instance/grafan.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Automatic source checking is opt-in for scheduled deployments.
ENABLE_SCRAPE_SCHEDULER=false
# Admin routes return 503 until this is set. Use a random token of at least 32 characters and keep it server-side.
ADMIN_API_TOKEN=replace-with-a-long-random-token
# Optional CV AI provider. Supported providers are enabled only when implemented and configured server-side.
CV_AI_PROVIDER=
CV_AI_API_KEY=
CV_AI_MODEL=gpt-6-astra
# Email notifications remain disabled until SMTP credentials are configured.
EMAIL_NOTIFICATIONS=false
# Optional email notification settings
SENDER_EMAIL=
EMAIL_PASSWORD=
